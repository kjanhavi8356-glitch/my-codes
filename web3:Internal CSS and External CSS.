}
/* Navigation Bar */
nav {
 background-color: #1e293b;
 text-align: center;
 padding: 15px;
}
nav a {
 color: white;
 text-decoration: none;
 margin: 0 20px;
 font-size: 17px;
}
nav a:hover {
 color: #60a5fa;
}
/* Main Content */
main {
 width: 80%;
 margin: 30px auto;
}
/* Cards */
card {
 background-color: white;
 padding: 25px;
 margin-bottom: 20px;
 border-radius: 10px;
 box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
}
.card h2 {
 color: #2563eb;
 border-bottom: 2px solid #2563eb;
 padding-bottom: 8px;
}
/* List */
.card li {
 padding: 8px;
 font-size: 17px;
}
/* Skills */
.skills {
