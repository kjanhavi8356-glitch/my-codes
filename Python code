1. Even or odd, then print all even numbers from 1 to the number
n = int(input("Enter a number: "))

if n % 2 == 0:
    print(n, "is even")
else:
    print(n, "is odd")

for i in range(1, n + 1):
    if i % 2 == 0:
        print(i)
