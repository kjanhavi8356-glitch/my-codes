8. List of five numbers: largest,
smallest, sum, append, remove  
code:
numbers = [12, 5, 8, 20, 3]

largest = numbers[0]
smallest = numbers[0]

for n in numbers:
    if n > largest:
        largest = n
    if n < smallest:
        smallest = n

print("Largest:", largest)
print("Smallest:", smallest)
print("Sum:", sum(numbers))

numbers.append(15)
numbers.remove(8)

print("Updated list:", numbers)

